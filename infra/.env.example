# MongoDB credentials — used by both the mongo container and the server's connection string
MONGO_ROOT_USER=redandan
MONGO_ROOT_PASSWORD=change_me_to_a_strong_password
DB_NAME=redandan

# JWT — use: openssl rand -hex 32
JWT_SECRET=change_me_to_a_strong_random_secret

# Server
SERVER_PORT=8080
GIN_MODE=release

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://redandan.vercel.app

# Cron protection — use: openssl rand -hex 32
CRON_SECRET=change_me_to_a_strong_random_secret

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

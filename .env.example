# MongoDB
MONGODB_URI=

# Auth.js — also used to sign bearer tokens and encrypt the TOTP secret
# Generate: openssl rand -base64 32
# WARNING: rotating this value invalidates all sessions, bearer tokens, and the stored TOTP secret
AUTH_SECRET=
AUTH_URL=

# CORS — comma-separated list of allowed origins for the standalone API
# Example: https://redandan.vercel.app,chrome-extension://<your-extension-id>
ALLOWED_ORIGINS=

# Push Notifications (VAPID) — added in Phase 5
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cron Security — added in Phase 5
# Generate: openssl rand -base64 32
CRON_SECRET=

# Seed Script (local only — not needed in Vercel)
SEED_USERNAME=
SEED_PASSWORD=

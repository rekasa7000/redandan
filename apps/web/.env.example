# MongoDB
MONGODB_URI=mongodb://reliva:<password>@localhost:27017/reliva?authSource=admin
DB_NAME=reliva

# Auth — signs session JWTs and bearer tokens
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Push Notifications VAPID keys — Phase 5
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron Security — Phase 5
CRON_SECRET=

# Seed script (local only — not needed in production)
SEED_EMAIL=you@example.com
SEED_PASSWORD=

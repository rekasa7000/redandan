# MongoDB
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=reliva

# JWT — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_to_a_strong_random_secret

# Server
SERVER_PORT=8080

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://reliva.vercel.app

# Cron protection — use a long random string
CRON_SECRET=change_me_to_a_strong_random_secret

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com
